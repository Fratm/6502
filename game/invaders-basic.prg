10 REM ***************************************
20 REM * CHAR INVADERS - BASIC VERSION       *
30 REM * A=LEFT  D=RIGHT  SPACE=FIRE         *
40 REM * CHARACTER GRAPHICS (NO SPRITES)     *
50 REM ***************************************
60 POKE53280,0:POKE53281,0:PRINT CHR$(147)
70 REM --- CONSTANTS
80 SC=1024:CR=55296
90 W=40:TOP=1
100 REM --- FORMATION SETTINGS
110 IR=3:IC=5:ISP=2:JSP=2
120 OX=5:OY=4:DIR=1:SPD=6:TC=0
130 REM --- PLAYER
140 PX=20:PY=23:POX=PX
150 REM --- BULLET
160 BA=0:BX=0:BY=0:BOY=0
170 REM --- CHARS (SCREEN CODES VIA PRINT/POKE)
180 CINV=81:CSHIP=82:CBUL=42:CEMP=32
190 REM NOTE: WE'LL USE PETSCII/SCREEN CODES BY POKEING SCREEN RAM
200 REM --- INVADER ALIVE ARRAY (1..INVCOUNT)
210 DIM AL(IR*IC)
220 FOR I=1 TO IR*IC:AL(I)=1:NEXT
230 REM --- UI TEXT
240 GOSUB 9000
250 REM --- INITIAL DRAW
260 GOSUB 2000
270 GOSUB 3000
280 REM --- MAIN LOOP
290 GET K$:IF K$<>"" THEN GOSUB 4000
300 TC=TC+1:IF TC>=SPD THEN TC=0:GOSUB 5000
310 IF BA=1 THEN GOSUB 6000
320 GOTO 290
1000 REM ===============================
1010 REM POKE CHAR+COLOR AT X,Y
1020 REM IN: X,Y,CH,CO
1030 AD=SC+Y*W+X:POKE AD,CH
1040 POKE CR+Y*W+X,CO
1050 RETURN
1100 REM ===============================
1110 REM READ CHAR AT X,Y -> R
1120 AD=SC+Y*W+X:R=PEEK(AD)
1130 RETURN
2000 REM ===============================
2010 REM DRAW INVADERS
2020 FOR I=1 TO IR*IC
2030 IF AL(I)=0 THEN 2090
2040 R0=INT((I-1)/IC):C0=(I-1)-R0*IC
2050 X=OX+C0*ISP:Y=OY+R0*JSP
2060 CH=CINV:CO=5:GOSUB 1000
2090 NEXT
2100 RETURN
2200 REM ===============================
2210 REM ERASE INVADERS
2220 FOR I=1 TO IR*IC
2230 IF AL(I)=0 THEN 2290
2240 R0=INT((I-1)/IC):C0=(I-1)-R0*IC
2250 X=OX+C0*ISP:Y=OY+R0*JSP
2260 CH=CEMP:CO=0:GOSUB 1000
2290 NEXT
2300 RETURN
3000 REM ===============================
3010 REM DRAW PLAYER
3020 X=PX:Y=PY:CH=CSHIP:CO=3:GOSUB 1000
3030 RETURN
3100 REM ===============================
3110 REM ERASE PLAYER (OLD X)
3120 X=POX:Y=PY:CH=CEMP:CO=0:GOSUB 1000
3130 RETURN
4000 REM ===============================
4010 REM HANDLE INPUT (A/D/SPACE)
4020 POX=PX
4030 IF K$="A" OR K$="a" THEN IF PX>0 THEN PX=PX-1
4040 IF K$="D" OR K$="d" THEN IF PX<39 THEN PX=PX+1
4050 IF K$=" " THEN IF BA=0 THEN BA=1:BX=PX:BY=PY-1:BOY=BY
4060 GOSUB 3100:GOSUB 3000
4070 RETURN
5000 REM ===============================
5010 REM UPDATE INVADERS
5020 GOSUB 2200
5030 IF DIR=1 THEN GOSUB 5100 ELSE GOSUB 5200
5040 GOSUB 2000
5050 RETURN
5100 REM MOVE RIGHT OR BOUNCE
5110 IF OX+(IC-1)*ISP>=39 THEN GOSUB 5300:RETURN
5120 OX=OX+1:RETURN
5200 REM MOVE LEFT OR BOUNCE
5210 IF OX<=0 THEN GOSUB 5300:RETURN
5220 OX=OX-1:RETURN
5300 REM DOWN + REVERSE
5310 OY=OY+1
5320 DIR=-DIR
5330 RETURN
6000 REM ===============================
6010 REM UPDATE BULLET
6020 REM ERASE OLD
6030 X=BX:Y=BOY:CH=CEMP:CO=0:GOSUB 1000
6040 BOY=BY
6050 IF BY<=0 THEN BA=0:RETURN
6060 BY=BY-1
6070 REM COLLISION CHECK
6080 X=BX:Y=BY:GOSUB 1100
6090 IF R=CINV THEN GOSUB 6500:BA=0:RETURN
6100 IF BY<=TOP THEN BA=0:RETURN
6110 REM DRAW NEW
6120 X=BX:Y=BY:CH=CBUL:CO=1:GOSUB 1000
6130 RETURN
6500 REM ===============================
6510 REM HIT INVADER AT BX,BY: BLANK + MARK DEAD
6520 X=BX:Y=BY:CH=CEMP:CO=0:GOSUB 1000
6530 REM MAP SCREEN POS BACK TO INVADER INDEX
6540 RR=INT((BY-OY)/JSP):CC=INT((BX-OX)/ISP)
6550 IF RR<0 OR RR>=IR THEN RETURN
6560 IF CC<0 OR CC>=IC THEN RETURN
6570 IDX=RR*IC+CC+1
6580 IF IDX<1 OR IDX>IR*IC THEN RETURN
6590 AL(IDX)=0
6600 RETURN
9000 REM ===============================
9010 REM CLEAR SCREEN + UI
9020 PRINT CHR$(147)
9030 T$="CHAR INVADERS  A/D MOVE  SPACE FIRE"
9040 FOR I=1 TO LEN(T$)
9050 X=I-1:Y=0:CH=ASC(MID$(T$,I,1))
9060 REM SCREEN CODES: BASIC ASCII to screen code is not 1:1 for letters.
9070 REM SIMPLE FIX: USE PRINT FOR THE HEADER INSTEAD OF POKES
9080 NEXT
9090 PRINT T$
9100 RETURN

